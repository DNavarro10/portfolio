/**
 * Cloudflare Workers config (static assets only, no server code yet).
 * Cloudflare builds the site with `npm run build` and serves the files in dist/.
 * Docs: https://developers.cloudflare.com/workers/static-assets/
 *
 * - not_found_handling "404-page": a missing URL gets the nearest 404.html
 *   (/404.html for English, /es/404.html for Spanish) with a real 404 status.
 * - public/_headers and public/_redirects (copied into dist/) are applied automatically.
 * - The contact form's server route and the Astro Cloudflare adapter are added later
 *   (roadmap step 7); this file will gain a "main" entry then.
 */
{
  "name": "diegonavarrocr",
  "compatibility_date": "2026-10-15",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
}
