---
/**
 * Contact page, shared by /contact/ and /es/contacto/.
 * Order: contact form (main action) → other ways (LinkedIn, CV) → working details → services.
 * The form is plain HTML (no JavaScript). While SITE.contactForm.enabled is false its
 * fields are disabled and a "coming soon" note shows; it is switched on at the Cloudflare
 * deploy step, when the server route that emails the message exists.
 * The CV button appears automatically once OWNER.cv has a file for this language.
 * JSON-LD: ContactPage (main entity: Person, whose sameAs lists the profiles).
 */
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';
import Button from '@/components/ui/Button.astro';
import Section from '@/components/ui/Section.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { OWNER, SITE } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import type { Lang } from '@/i18n/config';
import { ROUTES } from '@/i18n/routes';
import { routeAlternates, routePath, useTranslations } from '@/i18n/utils';
import { breadcrumbSchema, contactPageSchema } from '@/lib/schema';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const c = t.contact;
const path = routePath('contact', lang);
const linkedin = OWNER.profiles.find((profile) => profile.label === 'LinkedIn');
const cvFile = OWNER.cv[lang];
const form = SITE.contactForm;

const crumbs = [
  { name: t.nav.home, path: routePath('home', lang) },
  { name: t.nav.contact, path },
];
---

<BaseLayout
  title={t.pages.contact.title}
  description={t.pages.contact.description}
  lang={lang}
  alternates={routeAlternates('contact')}
  noindex={!ROUTES.contact.published}
  bareTitle
  jsonLd={[contactPageSchema(path, lang), breadcrumbSchema(crumbs)]}
>
  <Section labelledby="contact-title" narrow>
    <Breadcrumbs lang={lang} items={crumbs} />
    <SectionHeading
      level="h1"
      id="contact-title"
      eyebrow={c.eyebrow}
      title={c.title}
      description={c.intro}
    />

    <section class="panel panel--primary" aria-labelledby="form-title">
      <h2 id="form-title">{c.form.title}</h2>
      <p>{c.form.text}</p>
      {!form.enabled && (
        <p class="form-soon" id="form-soon">
          {c.form.soon}
        </p>
      )}
      <form
        class="form"
        method="post"
        action={form.enabled ? form.action : undefined}
        aria-describedby={form.enabled ? undefined : 'form-soon'}
      >
        <fieldset disabled={!form.enabled}>
          <legend class="visually-hidden">{c.form.title}</legend>
          <input type="hidden" name="lang" value={lang} />
          <div class="form__row">
            <div class="field">
              <label for="cf-name">{c.form.name}</label>
              <input
                id="cf-name"
                name="name"
                type="text"
                autocomplete="name"
                required
                maxlength="100"
              />
            </div>
            <div class="field">
              <label for="cf-email">{c.form.email}</label>
              <input
                id="cf-email"
                name="email"
                type="email"
                autocomplete="email"
                required
                maxlength="200"
              />
            </div>
          </div>
          <div class="form__row">
            <div class="field">
              <label for="cf-company">{c.form.company}</label>
              <input
                id="cf-company"
                name="company"
                type="text"
                autocomplete="organization"
                maxlength="100"
              />
            </div>
            <div class="field">
              <label for="cf-topic">{c.form.topic}</label>
              <select id="cf-topic" name="topic" required>
                {c.form.topics.map((topic) => (
                  <option value={topic.value}>{topic.label}</option>
                ))}
              </select>
            </div>
          </div>
          <div class="field">
            <label for="cf-message">{c.form.message}</label>
            <textarea
              id="cf-message"
              name="message"
              rows="6"
              required
              minlength="10"
              maxlength="5000"
            ></textarea>
          </div>
          <Button type="submit">{c.form.submit}</Button>
          <p class="form__privacy text-muted">{c.form.privacy}</p>
        </fieldset>
      </form>
    </section>

    <div class="contact-grid">
      <section class="panel" aria-labelledby="other-title">
        <h2 id="other-title">{c.other.title}</h2>
        <div class="other__actions">
          {linkedin && (
            <Button
              href={linkedin.url}
              variant="secondary"
              icon="external"
              rest={{ rel: 'me noopener' }}
            >
              {c.linkedin.button}
            </Button>
          )}
          {cvFile && (
            <Button href={cvFile} variant="secondary" icon="download" download>
              {t.home.actions.downloadCv}
            </Button>
          )}
        </div>
      </section>

      <section class="panel" aria-labelledby="details-title">
        <h2 id="details-title">{c.details.title}</h2>
        <dl class="details">
          {c.details.items.map((item) => (
            <div>
              <dt>{item.label}</dt>
              <dd>{item.value}</dd>
            </div>
          ))}
        </dl>
      </section>
    </div>
  </Section>

  <Section labelledby="services-title" tinted narrow>
    <SectionHeading
      id="services-title"
      eyebrow={c.services.eyebrow}
      title={c.services.title}
      description={c.services.text}
    />
  </Section>
</BaseLayout>

<style>
  .contact-grid {
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-5);
  }
  .panel {
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }
  .panel--primary {
    border-left: 3px solid var(--color-accent);
  }
  .panel h2 {
    margin-bottom: var(--space-2);
    font-size: var(--fs-lg);
  }
  .panel > p {
    color: var(--color-text-muted);
  }
  .details {
    display: grid;
    gap: var(--space-3);
    margin: 0;
  }
  .details div {
    display: grid;
    grid-template-columns: minmax(7rem, auto) 1fr;
    gap: var(--space-3);
  }
  .details dt {
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    color: var(--color-accent);
  }
  .details dd {
    margin: 0;
  }
  .form-soon {
    margin: 0 0 var(--space-5);
    padding: var(--space-3) var(--space-4);
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius);
    font-size: var(--fs-sm);
    color: var(--color-text);
  }
  .form fieldset {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  .form fieldset:disabled {
    opacity: 0.6;
  }
  .form__row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: var(--space-4);
  }
  .field {
    display: grid;
    gap: var(--space-1);
  }
  .field label {
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
  }
  .field input,
  .field select,
  .field textarea {
    width: 100%;
    min-height: 44px;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius);
    background: var(--color-bg);
  }
  .field textarea {
    resize: vertical;
  }
  .form :global(.btn) {
    justify-self: start;
  }
  .form__privacy {
    margin: 0;
    font-size: var(--fs-xs);
  }
  .other__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
</style>
