---
/**
 * Not-found page, one per language: /404.html (English) and /es/404.html (Spanish).
 * Cloudflare serves the nearest 404.html with an HTTP 404 status, so search engines
 * drop broken URLs (no "soft 404"). Always noindex.
 *
 * For visitors it:
 *   1. guesses the page they meant (typo-tolerant match against every published URL),
 *   2. redirects there, or to the home page, after a 10-second visible countdown,
 *   3. lets them cancel ("Stay on this page"), as WCAG 2.2.1 requires for time limits,
 *   4. lists popular pages. Without JavaScript, the links still work.
 * Permanent moves of real pages belong in public/_redirects (301), not here.
 */
import Section from '@/components/ui/Section.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import type { Lang } from '@/i18n/config';
import { NAV_ROUTES, ROUTES } from '@/i18n/routes';
import { routePath, useTranslations } from '@/i18n/utils';
import { getIndexablePages } from '@/lib/pages';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const n = t.pages.notFound;
const home = routePath('home', lang);

// Every published page in this language: candidates for "did you mean".
const pages = (await getIndexablePages())
  .map((page) => page.versions[lang])
  .filter((version) => version !== undefined)
  .map((version) => ({ path: version.path, title: version.title.split(' | ')[0]! }));

const popular = NAV_ROUTES.filter((key) => ROUTES[key].published).map((key) => ({
  path: routePath(key, lang),
  label: t.nav[key],
}));
---

<BaseLayout
  title={n.title}
  description={n.description}
  lang={lang}
  noindex
  canonicalPath={lang === 'en' ? '/404/' : '/es/404/'}
>
  <Section narrow>
    <div
      class="not-found"
      data-not-found
      data-pages={JSON.stringify(pages)}
      data-home={home}
      data-strings={JSON.stringify(n)}
    >
      <p class="mono-label">404</p>
      <h1>{n.title}</h1>
      <p class="lead">{n.intro}</p>

      <p class="not-found__suggestion" data-out="suggestion" hidden></p>
      <div class="not-found__redirect" data-out="redirect" hidden>
        <p data-out="countdown" aria-live="polite"></p>
        <button type="button" class="tool-button" data-stay>
          {n.stay}
        </button>
      </div>

      <h2 class="not-found__popular">{n.popular}</h2>
      <ul class="not-found__links">
        <li>
          <a href={home}>{n.backHome}</a>
        </li>
        {popular.map((item) => (
          <li>
            <a href={item.path}>{item.label}</a>
          </li>
        ))}
      </ul>
    </div>
  </Section>
</BaseLayout>

<script>
  import { fill } from '@/components/tools/client';

  interface Strings {
    suggestion: string;
    redirect: string;
    redirectHome: string;
    stayed: string;
  }
  interface Candidate {
    path: string;
    title: string;
  }

  const SECONDS = 10;

  /** Edit distance between two strings (how many typos apart they are). */
  const distance = (a: string, b: string): number => {
    const row = Array.from({ length: b.length + 1 }, (_, i) => i);
    for (let i = 1; i <= a.length; i++) {
      let previous = row[0]!;
      row[0] = i;
      for (let j = 1; j <= b.length; j++) {
        const current = row[j]!;
        row[j] = Math.min(row[j]! + 1, row[j - 1]! + 1, previous + (a[i - 1] === b[j - 1] ? 0 : 1));
        previous = current;
      }
    }
    return row[b.length]!;
  };

  const normalize = (path: string) => {
    let clean = path;
    try {
      clean = decodeURIComponent(path);
    } catch {
      /* keep the raw path */
    }
    clean = clean
      .toLowerCase()
      .replace(/\/index\.html?$/, '/')
      .replace(/\.html?$/, '');
    return clean.endsWith('/') ? clean : `${clean}/`;
  };

  const root = document.querySelector<HTMLElement>('[data-not-found]');
  if (root) {
    const s = JSON.parse(root.dataset.strings ?? '{}') as Strings;
    const pages = JSON.parse(root.dataset.pages ?? '[]') as Candidate[];
    const home = root.dataset.home ?? '/';
    const current = normalize(window.location.pathname);
    const out = (name: string) => root.querySelector<HTMLElement>(`[data-out="${name}"]`)!;

    // Best match: smallest edit distance relative to length; accept up to ~35% different.
    let best: Candidate | null = null;
    let bestScore = 0;
    for (const page of pages) {
      const score = 1 - distance(current, page.path) / Math.max(current.length, page.path.length);
      if (score > bestScore) {
        best = page;
        bestScore = score;
      }
    }
    const isErrorPage = /\/404\/?$/.test(current);
    const suggestion =
      !isErrorPage && best && bestScore >= 0.65 && best.path !== home ? best : null;

    if (suggestion) {
      const p = out('suggestion');
      const link = Object.assign(document.createElement('a'), {
        href: suggestion.path,
        textContent: suggestion.title,
      });
      p.append(`${s.suggestion} `, link, '?');
      p.hidden = false;
    }

    const target = suggestion?.path ?? home;
    const targetName = suggestion?.title ?? s.redirectHome;
    let remaining = SECONDS;
    const countdown = out('countdown');
    const render = () => {
      countdown.textContent = fill(s.redirect, { page: targetName, seconds: remaining });
    };
    out('redirect').hidden = false;
    render();
    // Only the first message is announced to screen readers; later ticks update silently.
    countdown.removeAttribute('aria-live');

    const timer = window.setInterval(() => {
      remaining -= 1;
      if (remaining <= 0) {
        window.clearInterval(timer);
        window.location.replace(target);
        return;
      }
      render();
    }, 1000);

    root.querySelector('[data-stay]')!.addEventListener('click', (event) => {
      window.clearInterval(timer);
      countdown.textContent = s.stayed;
      (event.currentTarget as HTMLElement).hidden = true;
    });
  }
</script>

<style>
  .not-found__suggestion {
    margin: var(--space-5) 0 0;
    font-size: var(--fs-lg);
  }
  .not-found__redirect {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
    margin-top: var(--space-5);
    padding: var(--space-4);
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius);
  }
  .not-found__redirect p {
    margin: 0;
  }
  .not-found__popular {
    margin-top: var(--space-7);
    font-size: var(--fs-lg);
  }
  .not-found__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .not-found__links a {
    display: inline-block;
    padding-block: var(--space-2);
  }
</style>
