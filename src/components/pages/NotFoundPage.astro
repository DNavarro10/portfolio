---
/**
 * Not-found page, one per language: /404.html (English) and /es/404.html (Spanish).
 * Cloudflare serves the nearest 404.html with an HTTP 404 status, so search engines
 * drop broken URLs (no "soft 404"). Always noindex.
 *
 * For visitors: a short message, then an automatic redirect to the home page after
 * a visible 10-second countdown they can cancel ("Stay on this page", as WCAG 2.2.1
 * requires for time limits), plus quick links. Without JavaScript, the links still work.
 * Permanent moves of real pages belong in public/_redirects (301), not here.
 */
import Section from '@/components/ui/Section.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import type { Lang } from '@/i18n/config';
import { NAV_ROUTES, ROUTES } from '@/i18n/routes';
import { routePath, useTranslations } from '@/i18n/utils';

interface Props {
  lang: Lang;
}

/** Seconds before the automatic redirect to the home page. */
const SECONDS = 10;

const { lang } = Astro.props;
const t = useTranslations(lang);
const n = t.pages.notFound;
const home = routePath('home', lang);
const links = NAV_ROUTES.filter((key) => ROUTES[key].published).map((key) => ({
  path: routePath(key, lang),
  label: t.nav[key],
}));
---

<BaseLayout
  title={n.title}
  description={n.description}
  lang={lang}
  noindex
  canonicalPath={lang === 'en' ? '/404/' : '/es/404/'}
>
  <Section narrow>
    <div
      class="not-found"
      data-not-found
      data-home={home}
      data-seconds={SECONDS}
      data-strings={JSON.stringify({ redirect: n.redirect, stayed: n.stayed })}
    >
      <p class="mono-label">404</p>
      <h1>{n.title}</h1>
      <p class="lead">{n.intro}</p>

      <div class="not-found__redirect" data-out="redirect" hidden>
        <p data-out="countdown" aria-live="polite"></p>
        <button type="button" class="tool-button" data-stay>
          {n.stay}
        </button>
      </div>

      <h2 class="not-found__popular">{n.popular}</h2>
      <ul class="not-found__links">
        <li>
          <a href={home}>{n.backHome}</a>
        </li>
        {links.map((item) => (
          <li>
            <a href={item.path}>{item.label}</a>
          </li>
        ))}
      </ul>
    </div>
  </Section>
</BaseLayout>

<script>
  import { fill } from '@/components/tools/client';

  const root = document.querySelector<HTMLElement>('[data-not-found]');
  if (root) {
    const s = JSON.parse(root.dataset.strings ?? '{}') as { redirect: string; stayed: string };
    const home = root.dataset.home ?? '/';
    let remaining = Number(root.dataset.seconds ?? 10);
    const box = root.querySelector<HTMLElement>('[data-out="redirect"]')!;
    const countdown = root.querySelector<HTMLElement>('[data-out="countdown"]')!;
    const render = () => {
      countdown.textContent = fill(s.redirect, { seconds: remaining });
    };

    box.hidden = false;
    render();
    // Only the first message is announced to screen readers; later ticks update silently.
    countdown.removeAttribute('aria-live');

    const timer = window.setInterval(() => {
      remaining -= 1;
      if (remaining <= 0) {
        window.clearInterval(timer);
        window.location.replace(home);
        return;
      }
      render();
    }, 1000);

    root.querySelector('[data-stay]')!.addEventListener('click', (event) => {
      window.clearInterval(timer);
      countdown.textContent = s.stayed;
      (event.currentTarget as HTMLElement).hidden = true;
    });
  }
</script>

<style>
  .not-found__redirect {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
    margin-top: var(--space-5);
    padding: var(--space-4);
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius);
  }
  .not-found__redirect p {
    margin: 0;
  }
  .not-found__popular {
    margin-top: var(--space-7);
    font-size: var(--fs-lg);
  }
  .not-found__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .not-found__links a {
    display: inline-block;
    padding-block: var(--space-2);
  }
</style>
