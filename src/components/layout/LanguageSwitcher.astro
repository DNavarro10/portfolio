---
/**
 * Link to the same page in the other language. If this page has no
 * translation, it links to the other language's home page instead.
 * It's a plain link (no auto-redirects based on browser language).
 */
import { LANG_META, LANGS, type Lang } from '@/i18n/config';
import { routePath, useTranslations, type Alternates } from '@/i18n/utils';

interface Props {
  lang: Lang;
  alternates?: Alternates;
}

const { lang, alternates } = Astro.props;
const t = useTranslations(lang);
const target = LANGS.find((l) => l !== lang)!;
const href = alternates?.[target] ?? routePath('home', target);
---

<a
  class="lang-switch"
  href={href}
  hreflang={LANG_META[target].hreflang}
  lang={LANG_META[target].htmlLang}
>
  <span class="lang-switch__code" aria-hidden="true">
    {target.toUpperCase()}
  </span>
  {t.langSwitch.label}
</a>

<style>
  .lang-switch {
    gap: var(--space-2);
  }
  .lang-switch__code {
    padding: 0 0.35em;
    border: 1px solid currentColor;
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    line-height: 1.5;
  }
</style>
