---
import { OWNER, SITE } from '@/config/site';
import type { Lang } from '@/i18n/config';
import { useTranslations } from '@/i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
const legal = `© ${year} ${OWNER.name}. ${t.footer.rights} ${t.footer.builtWith}`;
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div>
      <p class="site-footer__name">{OWNER.name}</p>
      <p class="site-footer__tagline">{t.site.tagline}</p>
    </div>
    <ul class="site-footer__links">
      {OWNER.profiles.map((profile) => (
        <li>
          <a href={profile.url} rel="me noopener">
            {profile.label}
          </a>
        </li>
      ))}
      <li>
        <a href={SITE.sourceUrl} rel="noopener">
          {t.footer.sourceCode}
        </a>
      </li>
    </ul>
    <p class="site-footer__legal">{legal}</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    background: var(--color-surface-2);
    font-size: var(--fs-sm);
    color: var(--color-text-muted);
  }
  .site-footer__inner {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-7);
  }
  .site-footer p {
    margin: 0;
  }
  .site-footer__name {
    color: var(--color-text);
    font-weight: var(--fw-semibold);
  }
  .site-footer__tagline {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
  }
  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-footer__links a {
    display: inline-block;
    padding-block: var(--space-2);
  }
  .site-footer__legal {
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
    font-size: var(--fs-xs);
  }

  @media (min-width: 52rem) {
    .site-footer__inner {
      grid-template-columns: 1fr auto;
      align-items: center;
    }
    .site-footer__legal {
      grid-column: 1 / -1;
    }
  }
</style>
