---
/**
 * Section title with the small mono label above it:
 *   // TECHNICAL SEO
 *   Organic growth, engineered.
 * The "//" is decorative and hidden from screen readers.
 */
interface Props {
  title: string;
  eyebrow?: string;
  description?: string;
  /** id for the heading, so the section can use aria-labelledby. */
  id?: string;
  level?: 'h1' | 'h2' | 'h3';
}

const { title, eyebrow, description, id, level = 'h2' } = Astro.props;
const Heading = level;
---

<div class="section-heading">
  {eyebrow && <p class="section-heading__eyebrow mono-label">{eyebrow}</p>}
  <Heading id={id} class="section-heading__title">
    {title}
  </Heading>
  {description && <p class="section-heading__description lead">{description}</p>}
</div>

<style>
  .section-heading {
    margin-bottom: var(--space-6);
  }
  .section-heading__eyebrow {
    margin: 0 0 var(--space-2);
  }
  .section-heading__eyebrow::before {
    content: '// ' / '';
    opacity: 0.7;
  }
  .section-heading__title {
    margin-bottom: var(--space-3);
  }
  .section-heading__description {
    margin: 0;
  }
</style>
