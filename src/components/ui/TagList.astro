---
/** A list of tags. Uses a real <ul> so screen readers announce the count. */
import Tag from './Tag.astro';

interface Props {
  tags: readonly string[];
  /** Accessible name for the list, e.g. "Topics". */
  label?: string;
}

const { tags, label } = Astro.props;
---

{tags.length > 0 && (
  <ul class="tag-list" aria-label={label}>
    {tags.map((tag) => (
      <li>
        <Tag>{tag}</Tag>
      </li>
    ))}
  </ul>
)}

<style>
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
