---
/**
 * Every SEO tag for a page's <head>, in one place:
 * title, meta description, robots, canonical, hreflang,
 * Open Graph, Twitter card, and JSON-LD.
 *
 * Pages never write these tags themselves; they pass props to BaseLayout.
 */
import { SITE } from '@/config/site';
import { DEFAULT_LANG, LANG_META, LANGS, type Lang } from '@/i18n/config';
import { absoluteUrl, hasAllLanguages, type Alternates } from '@/i18n/utils';
import type { JsonLdNode } from '@/lib/schema';
import JsonLd from './JsonLd.astro';

export interface SeoProps {
  /** Page title without the site name (the brand suffix is added here). */
  title: string;
  /** Unique meta description, ideally 120–160 characters. */
  description: string;
  lang: Lang;
  /** Same content in each language. hreflang is only output when ALL languages exist. */
  alternates?: Alternates;
  /** Canonical path. Defaults to the current URL path (self-referencing). */
  canonicalPath?: string;
  /** Set true to keep the page out of search results. */
  noindex?: boolean;
  /** Use the title as-is, without " | Site name" (e.g. the home page). */
  bareTitle?: boolean;
  ogType?: 'website' | 'article' | 'profile';
  /** Social share image path, relative to the site root. */
  ogImage?: string;
  ogImageAlt?: string;
  jsonLd?: JsonLdNode[];
}

type Props = SeoProps;

const {
  title,
  description,
  lang,
  alternates,
  canonicalPath = Astro.url.pathname,
  noindex = false,
  bareTitle = false,
  ogType = 'website',
  ogImage = SITE.defaultOgImage,
  ogImageAlt = title,
  jsonLd = [],
} = Astro.props;

const fullTitle = bareTitle ? title : `${title} | ${SITE.name}`;
const canonical = absoluteUrl(canonicalPath);
const imageUrl = absoluteUrl(ogImage);
const showHreflang = !noindex && alternates !== undefined && hasAllLanguages(alternates);
const otherLocales = LANGS.filter((l) => l !== lang && alternates?.[l]).map(
  (l) => LANG_META[l].ogLocale,
);
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta
  name="robots"
  content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'}
/>
<link rel="canonical" href={canonical} />

{showHreflang && (
  <>
    {LANGS.map((l) => (
      <link rel="alternate" hreflang={LANG_META[l].hreflang} href={absoluteUrl(alternates![l]!)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={absoluteUrl(alternates![DEFAULT_LANG]!)} />
  </>
)}

<!-- Open Graph -->
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:alt" content={ogImageAlt} />
{ogImage === SITE.defaultOgImage && (
  <>
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
  </>
)}
<meta property="og:locale" content={LANG_META[lang].ogLocale} />
{otherLocales.map((locale) => (
  <meta property="og:locale:alternate" content={locale} />
))}

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={ogImageAlt} />
{SITE.twitterHandle && <meta name="twitter:site" content={`@${SITE.twitterHandle}`} />}

<JsonLd nodes={jsonLd} />
